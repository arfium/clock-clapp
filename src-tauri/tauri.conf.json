{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clock",
  "version": "0.2.0",
  "identifier": "com.arfium.clock",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "clock",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["../assets/icon.png"]
  }
}
