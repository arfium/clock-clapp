{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clock",
  "version": "0.3.0",
  "identifier": "com.arfium.clock",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clock",
        "visible": false,
        "width": 600,
        "height": 640,
        "minWidth": 480,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "../assets/icon.png"
    ]
  }
}
